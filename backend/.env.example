# ============================================================
# Medusa Backend — Environment Variables
# Copy this to .env in the backend/ directory
# ============================================================

# ----- Database -----
DATABASE_URL=postgres://dtm_user:dtm_password@localhost:5432/dont_tell_mama

# ----- Medusa Secrets -----
JWT_SECRET=change_me_at_least_32_chars_long
COOKIE_SECRET=change_me_at_least_32_chars_long

# ----- Admin Onboarding -----
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_BACKEND_URL=http://localhost:9000

# ----- CORS -----
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:7001
