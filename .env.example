# ============================================================
# Don't Tell Mama — Environment Variables
# Copy this to .env.local (storefront) or .env (backend)
# ============================================================

# ----- Database -----
DATABASE_URL=postgres://user:password@localhost:5432/dont_tell_mama

# ----- Medusa -----
JWT_SECRET=change_me_at_least_32_chars_long
COOKIE_SECRET=change_me_at_least_32_chars_long
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# ----- Auth (NextAuth / custom) -----
AUTH_SECRET=change_me_32_chars_minimum_here

# ----- Cloudinary -----
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Payment — Razorpay -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ----- Email — Resend -----
RESEND_API_KEY=re_WPh24hHz_LC1wUi6rMpd2kXRJFnc8fdQ3
EMAIL_FROM=onboarding@resend.dev

# ----- Storefront public vars (prefix NEXT_PUBLIC_) -----
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_DEFAULT_REGION=in
